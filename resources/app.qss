/* AdaptNote dark reading workspace; document pages remain source-faithful. */
QMainWindow, QDialog { background:#0f1115; color:#e6e9ef; font-family:"Segoe UI","Inter","Noto Sans CJK SC",sans-serif; font-size:13px; }

QWidget#applicationRail { background:#171a21; border-bottom:1px solid #2a2f3a; }
QLabel#applicationBrand {
    color: #8bb8ff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.2px;
    padding: 4px 2px;
}
QWidget#applicationRail QTabBar::tab {
    background: transparent;
    border-color: transparent;
    padding: 6px 15px;
}
QWidget#applicationRail QTabBar::tab:selected {
    background: #1e222b;
    border-color: #2a2f3a;
}
QWidget#documentStrip QToolButton { background:transparent; border-color:transparent; color:#c8ced8;
    padding: 5px 9px;
}
QWidget#documentStrip QToolButton:hover { background:#242a35; border-color:#343c4a;
}
QWidget#documentStrip { background:#171a21; border-bottom:1px solid #2a2f3a; }
QWidget#bookshelfDock QWidget { background:#171a21; color:#d5dae3; }
QDockWidget#bookshelfDock::title { background:#171a21; color:#8f9aaa; padding:7px 10px; border:0; }
QDockWidget#bookshelfDock::close-button, QDockWidget#bookshelfDock::float-button { width:0; height:0; }
QLabel#shelfHeader { color:#9aa4b2; font-size:11px; font-weight:600; letter-spacing:0.5px; }
QPushButton#shelfAddBook { background:#1e222b; color:#e6e9ef; border:1px solid #343a46; }
QListWidget#bookshelfList, QListWidget#topicShelfList { background:#171a21; }
QWidget#bookshelfDock QTabWidget::pane { background:#171a21; border:0; }
QWidget#bookshelfDock QTabBar::tab { color:#9aa4b2; background:transparent; padding:5px 7px; margin-right:1px; font-size:10.5px; }
QWidget#bookshelfDock QTabBar::tab:selected { color:#e6e9ef; background:#1e222b; border-color:#2a2f3a; }
QWidget#bookshelfDock QTabBar::scroller { width:12px; }
QWidget#bookshelfDock QTabBar QToolButton { width:12px; padding:0; border:0; color:#9aa4b2; }
QWidget#notesDock QWidget { background:#171a21; color:#d5dae3; }
QWidget#notesDock QListWidget#notebookOutline { background:#171a21; }
QWidget#notesDock QTreeWidget::item:selected { background:#22304a; color:#a9cbff; }
QWidget#notesDock QTabWidget::pane { background:#171a21; }
QWidget#notesDock QTabBar::tab { padding:6px 8px; margin-right:1px; font-size:11px; }
QWidget#notesDock QTabWidget::tab-bar { alignment:left; }
QLabel#shelfHeader, QLabel#sidePanelHint, QLabel#notebookNotesHeader { color:#9aa4b2; }
QLabel#notebookNotesHeader { font-size:13px; font-weight:600; }
QLabel#currentNotebookTitle { color:#e6e9ef;
    font-size: 13px;
    font-weight: 650;
    padding: 0 8px 0 2px;
}
QLabel#notebookHeader {
    color: #202124;
    font-size: 15px;
    font-weight: 650;
    padding: 8px 14px;
}

/* Shell tokens: background #0f1115, panels #171a21/#1e222b, line #2a2f3a, accent #5b9dff. */
QToolBar { background:#171a21; border:none; border-bottom:1px solid #2a2f3a;
    padding: 4px 12px;
    spacing: 4px;
    min-height: 38px;
}
QToolBar::separator { background:#343a46;
    width: 1px;
    margin: 6px 6px;
}

QToolBar QToolButton, QToolBar QPushButton { background:transparent; border:1px solid transparent; border-radius:8px; padding:4px 5px; min-height:26px; color:#dce1ea; font-size:12.5px;
}
QToolBar QToolButton:hover, QToolBar QPushButton:hover { background:#242a35; border-color:#343c4a;
}
QToolBar QToolButton:pressed, QToolBar QPushButton:pressed { background:#303949;
}
/* an active (exclusive) tool must be obvious, not just a slightly darker hover */
QToolBar QToolButton:checked { background:#22304a; border-color:#35507d; color:#a9cbff;
    font-weight: 600;
}
QToolBar QToolButton:disabled, QToolBar QPushButton:disabled {
    color: #aab2bd;
    background: transparent;
}
QToolBar QToolButton:focus, QToolBar QPushButton:focus { border-color:#5277ad;
}

QToolBar QLabel { color:#9aa4b2;
    font-size: 12px;
    padding: 0 2px;
}

/* buttons that are not in a toolbar (mind panel, dialogs) share the same metrics */
QPushButton { background:#1e222b; border:1px solid #2a2f3a;
    border-radius: 9px;
    padding: 5px 11px;
    min-height: 27px;
    color: #e6e9ef;
    font-size: 12.5px;
}
QPushButton:hover { background:#252a35; border-color:#5b9dff; color:#8bb8ff; }
QPushButton:pressed { background:#303949; }
QPushButton:disabled { color:#687181; background:#171a21; border-color:#242a35; }

QSplitter::handle { background:#0f1115; }
QSplitter::handle:hover { background:#3b4555; }
QSplitter::handle:horizontal { width: 5px; }

QComboBox { background:#1e222b; border:1px solid #2a2f3a;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 20px;
    color: #e6e9ef;
}
QComboBox:hover { border-color:#5b9dff; }
QLineEdit, QPlainTextEdit, QTextEdit { background:#1e222b; border:1px solid #2a2f3a;
    border-radius: 8px;
    padding: 7px 9px;
    color: #e6e9ef;
    selection-background-color: #35507d;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color:#5b9dff; }
QComboBox#readerAppearance { min-width:74px; background:#1e222b; border-color:#343a46; }
QComboBox QAbstractItemView { background:#1e222b; border:1px solid #343a46; selection-background-color:#22304a; selection-color:#a9cbff;
    outline: 0;
}

QDockWidget { color:#c8ced8;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title { background:#171a21; padding:9px 14px; border-bottom:1px solid #2a2f3a; color:#9aa4b2;
    font-size: 11.5px;
    font-weight: 650;
}

QTabWidget::pane { border:none; background:#171a21;
}
QTabBar::tab { background:transparent; color:#9aa4b2;
    padding: 7px 13px;
    border: 1px solid transparent;
    border-radius: 9px;
    margin-right: 4px;
    font-size: 12px;
}
QTabBar::tab:selected { background:#1e222b; color:#e6e9ef; border-color:#2a2f3a; font-weight:650; border-bottom:2px solid #5b9dff;
}
QTabBar#notebookTabs::tab { padding: 7px 16px; }
QTabBar#notebookDocuments::tab { padding: 7px 13px; }
QTabBar#notebookTabs { background:#171a21; }
QTabBar#notebookTabs::tab { background:transparent; border-color:transparent; }
QTabBar#notebookTabs::tab:selected { background:#1e222b; border-color:#2a2f3a; border-bottom-color:#1e222b; }

QTreeWidget, QListWidget { background:#171a21; border:none; outline:0; font-size:12.5px; color:#d5dae3;
    show-decoration-selected: 1;
}
QTreeWidget::item, QListWidget::item {
    padding: 6px 7px;
    border-radius: 7px;
    margin: 1px 4px;
}
QTreeWidget::item:hover, QListWidget::item:hover { background:#20252e;
}
QTreeWidget::item:selected, QListWidget::item:selected { background:#22304a; color:#a9cbff; }
QTreeWidget::item:selected { border:1px solid #35507d; }
QTreeWidget::item:selected:active { background:#22304a; color:#a9cbff; }
QTreeWidget::item:selected:!active { background:#20252e; color:#d5dae3; }
QTreeWidget { alternate-background-color:#1a1d25; }
QTreeWidget::item { border-bottom:1px solid #1c2028; }
QTreeWidget::branch:has-siblings:!adjoins-item { border-image: none; }
QTreeWidget::branch:has-siblings:adjoins-item { border-image: none; }
QTreeWidget::branch:!has-children:!has-siblings:adjoins-item { border-image: none; }
QTreeWidget::branch { background: transparent; }
QTreeWidget::branch:closed:has-children { image: none; }
QTreeWidget::branch:open:has-children { image: none; }

QStatusBar { background:#171a21; border-top:1px solid #2a2f3a; color:#9aa4b2;
    font-size: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical { background:#3b4350;
    border-radius: 6px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background:#566172; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
}
QScrollBar::handle:horizontal { background:#3b4350;
    border-radius: 6px;
    min-width: 32px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QMenu { background:#1e222b; border:1px solid #343a46;
    border-radius: 10px;
    padding: 5px;
}
QDialogButtonBox QPushButton { min-width: 72px; padding: 6px 14px; }
QMenu::item { padding:6px 22px 6px 12px; border-radius:5px; color:#e6e9ef;
}
QMenu::item:selected { background:#22304a; color:#a9cbff;
}
