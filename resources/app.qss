/* AdaptNote — light, low contrast, reading-first theme */

QMainWindow, QDialog {
    background: #f5f6f8;
    color: #202124;
    font-family: "Segoe UI", "Inter", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
}

QWidget#applicationRail {
    background: #f5f6f8;
    border-bottom: 1px solid #e5e7eb;
}
QLabel#applicationBrand {
    color: #202124;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.2px;
    padding: 4px 2px;
}
QWidget#applicationRail QTabBar::tab {
    background: transparent;
    border-color: transparent;
    padding: 6px 15px;
}
QWidget#applicationRail QTabBar::tab:selected {
    background: #ffffff;
    border-color: #e6e8ec;
}
QWidget#documentStrip QToolButton {
    background: transparent;
    border-color: transparent;
    color: #555c66;
    padding: 5px 9px;
}
QWidget#documentStrip QToolButton:hover {
    background: #f1f3f6;
    border-color: #eaedf1;
}
QWidget#documentStrip {
    background: #ffffff;
    border-bottom: 1px solid #e6e8ec;
}
QLabel#currentNotebookTitle {
    color: #343840;
    font-size: 13px;
    font-weight: 650;
    padding: 0 8px 0 2px;
}
QLabel#notebookHeader {
    color: #202124;
    font-size: 15px;
    font-weight: 650;
    padding: 8px 14px;
}

/* ---- design tokens (keep in sync with docs/reader-redesign/ui-spec.md) ----
   bg        #f5f6f8   panel #ffffff   line #e3e7ee
   text      #1d2129   muted #5b6472   faint #98a2b3
   accent    #2f6bd8   accent-soft #e9f0fd
   radius 6px (controls) / 10px (cards) · control height 24px · toolbar 34px
*/
QToolBar {
    background: #f5f6f8;
    border: none;
    border-bottom: 1px solid #e5e7eb;
    padding: 4px 12px;
    spacing: 4px;
    min-height: 38px;
}
QToolBar::separator {
    background: #e3e7ee;
    width: 1px;
    margin: 6px 6px;
}

QToolBar QToolButton, QToolBar QPushButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px 5px;
    min-height: 26px;
    color: #25272b;
    font-size: 12.5px;
}
QToolBar QToolButton:hover, QToolBar QPushButton:hover {
    background: #eef1f6;
    border-color: #dfe5ee;
}
QToolBar QToolButton:pressed, QToolBar QPushButton:pressed {
    background: #e2e9f4;
}
/* an active (exclusive) tool must be obvious, not just a slightly darker hover */
QToolBar QToolButton:checked {
    background: #e9f0fd;
    border-color: #c7dbfa;
    color: #17418f;
    font-weight: 600;
}
QToolBar QToolButton:disabled, QToolBar QPushButton:disabled {
    color: #aab2bd;
    background: transparent;
}
QToolBar QToolButton:focus, QToolBar QPushButton:focus {
    border-color: #c7dbfa;
}

QToolBar QLabel {
    color: #5b6472;
    font-size: 12px;
    padding: 0 2px;
}

/* buttons that are not in a toolbar (mind panel, dialogs) share the same metrics */
QPushButton {
    background: #ffffff;
    border: 1px solid #e1e4e9;
    border-radius: 9px;
    padding: 5px 11px;
    min-height: 27px;
    color: #25272b;
    font-size: 12.5px;
}
QPushButton:hover { background: #f4f7fb; border-color: #c4d2e4; }
QPushButton:pressed { background: #e9eef6; }
QPushButton:disabled { color: #aab2bd; background: #f7f8fa; border-color: #e6e9ee; }

QSplitter::handle { background: #f1f2f4; }
QSplitter::handle:hover { background: #d6d9df; }
QSplitter::handle:horizontal { width: 5px; }

QComboBox {
    background: #ffffff;
    border: 1px solid #d8dee6;
    border-radius: 6px;
    padding: 3px 8px;
    min-height: 20px;
    color: #2b3138;
}
QComboBox:hover { border-color: #b9c6d6; }
QLineEdit, QPlainTextEdit, QTextEdit {
    background: #ffffff;
    border: 1px solid #e0e3e8;
    border-radius: 8px;
    padding: 7px 9px;
    color: #25272b;
    selection-background-color: #dbe8ff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus { border-color: #8ba9d8; }
QComboBox#readerAppearance { min-width: 74px; background: #f7f8fa; border-color: #e8eaee; }
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #d8dee6;
    selection-background-color: #e6efff;
    selection-color: #1b4fa8;
    outline: 0;
}

QDockWidget {
    color: #4a525c;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #f7f8fa;
    padding: 9px 14px;
    border-bottom: 1px solid #ebedf0;
    color: #666b73;
    font-size: 11.5px;
    font-weight: 650;
}

QTabWidget::pane {
    border: none;
    background: #ffffff;
}
QTabBar::tab {
    background: transparent;
    color: #686c74;
    padding: 7px 13px;
    border: 1px solid transparent;
    border-radius: 9px;
    margin-right: 4px;
    font-size: 12px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #202124;
    border-color: #e6e8ec;
    font-weight: 650;
    border-bottom: 2px solid #7a9bd3;
}
QTabBar#notebookTabs::tab { padding: 7px 16px; }
QTabBar#notebookDocuments::tab { padding: 7px 13px; }
QTabBar#notebookTabs { background: #f5f6f8; }
QTabBar#notebookTabs::tab { background: transparent; border-color: transparent; }
QTabBar#notebookTabs::tab:selected { background: #ffffff; border-color: #e6e8ec; border-bottom-color: #ffffff; }

QTreeWidget, QListWidget {
    background: #ffffff;
    border: none;
    outline: 0;
    font-size: 12.5px;
    color: #303238;
    show-decoration-selected: 1;
}
QTreeWidget::item, QListWidget::item {
    padding: 6px 7px;
    border-radius: 7px;
    margin: 1px 4px;
}
QTreeWidget::item:hover, QListWidget::item:hover {
    background: #f4f6f9;
}
QTreeWidget::item:selected, QListWidget::item:selected {
    background: #eaf1ff;
    color: #2459b5;
}
QTreeWidget::item:selected { border: 1px solid #d5e2f7; }
QTreeWidget::item:selected:active { background: #e6efff; color: #2459b5; }
QTreeWidget::item:selected:!active { background: #f0f3f8; color: #303238; }
QTreeWidget { alternate-background-color: #fafbfc; }
QTreeWidget::item { border-bottom: 1px solid #f5f6f8; }
QTreeWidget::branch:has-siblings:!adjoins-item { border-image: none; }
QTreeWidget::branch:has-siblings:adjoins-item { border-image: none; }
QTreeWidget::branch:!has-children:!has-siblings:adjoins-item { border-image: none; }
QTreeWidget::branch { background: transparent; }
QTreeWidget::branch:closed:has-children { image: none; }
QTreeWidget::branch:open:has-children { image: none; }

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #e3e6ea;
    color: #5a636e;
    font-size: 12px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #c3cad4;
    border-radius: 6px;
    min-height: 32px;
}
QScrollBar::handle:vertical:hover { background: #a9b2bf; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
}
QScrollBar::handle:horizontal {
    background: #c3cad4;
    border-radius: 6px;
    min-width: 32px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

QMenu {
    background: #ffffff;
    border: 1px solid #e3e5e9;
    border-radius: 10px;
    padding: 5px;
}
QDialogButtonBox QPushButton { min-width: 72px; padding: 6px 14px; }
QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: 5px;
    color: #2b3138;
}
QMenu::item:selected {
    background: #edf3ff;
    color: #2459b5;
}
